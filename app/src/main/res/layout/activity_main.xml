<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#1a1a2e">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_shield"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Blocker+"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HTTP/HTTPS Proxy Ad Blocker"
        android:textSize="14sp"
        android:textColor="#8888aa"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unprotected"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#ff4444"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/blockedText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap Start to enable ad blocking"
        android:textSize="14sp"
        android:textColor="#aaaacc"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/proxyInfoText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#666688"
        android:layout_marginBottom="40dp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/toggleSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Block Adult Content"
        android:textColor="#ffffff"
        app:thumbTint="@color/switch_thumb"
        app:trackTint="@color/switch_track"
        android:checked="true"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/startStopButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="START"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:backgroundTint="@color/button_green"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VPN tunnel + local HTTP/HTTPS proxy\nRoutes all traffic through filter\nNo root required"
        android:textSize="12sp"
        android:textColor="#666688"
        android:gravity="center"
        android:lineSpacingExtra="2dp" />

</LinearLayout>
