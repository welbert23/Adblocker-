<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_shield"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blocker+"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VPN + DNS Ad Blocker"
            android:textSize="12sp"
            android:textColor="#8888aa"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unprotected"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#ff4444"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/blockedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap Start to enable"
            android:textSize="13sp"
            android:textColor="#aaaacc"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/statsSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#666688"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/toggleSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Block Adult Content"
            android:textColor="#ffffff"
            app:thumbTint="@color/switch_thumb"
            app:trackTint="@color/switch_track"
            android:checked="true"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/startStopButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="START"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:backgroundTint="@color/button_green" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333355" />

    <ScrollView
        android:id="@+id/panelSettings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Whitelist"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Domains that should bypass blocking"
                android:textSize="11sp"
                android:textColor="#8888aa"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <EditText android:id="@+id/settingsWhitelistInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Enter domain to allow"
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:textColorHint="#666688"
                    android:background="#222244"
                    android:padding="12dp"
                    android:inputType="textUri"
                    android:layout_marginEnd="8dp" />

                <Button android:id="@+id/settingsBtnAddWhitelist"
                    android:layout_width="56dp"
                    android:layout_height="match_parent"
                    android:text="+"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:backgroundTint="#448aff" />
            </LinearLayout>

            <TextView android:id="@+id/settingsWhitelistList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:text="No whitelisted domains"
                android:textSize="12sp"
                android:textColor="#8888aa"
                android:background="#222244"
                android:padding="8dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Custom Blocklist"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_marginBottom="4dp"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Additional domains to block"
                android:textSize="11sp"
                android:textColor="#8888aa"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <EditText android:id="@+id/inputCustomDomain"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Enter domain (e.g. example.com)"
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:textColorHint="#666688"
                    android:background="#222244"
                    android:padding="12dp"
                    android:inputType="textUri"
                    android:layout_marginEnd="8dp" />

                <Button android:id="@+id/btnAddDomain"
                    android:layout_width="56dp"
                    android:layout_height="match_parent"
                    android:text="+"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:backgroundTint="#00e676" />
            </LinearLayout>

            <TextView android:id="@+id/customDomainList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:text="No custom domains added yet"
                android:textSize="12sp"
                android:textColor="#8888aa"
                android:background="#222244"
                android:padding="8dp"
                android:layout_marginBottom="12dp"
                android:longClickable="true" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333355"
                android:layout_marginBottom="12dp" />

            <Button android:id="@+id/settingsBtnDns"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="DNS Server"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:backgroundTint="#333366"
                android:gravity="center|start"
                android:paddingStart="16dp"
                android:layout_marginBottom="4dp" />

            <Button android:id="@+id/settingsBtnPerApp"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Per-App Filtering"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:backgroundTint="#333366"
                android:gravity="center|start"
                android:paddingStart="16dp"
                android:layout_marginBottom="4dp" />

            <Button android:id="@+id/settingsBtnImportHosts"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Import Hosts File"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:backgroundTint="#333366"
                android:gravity="center|start"
                android:paddingStart="16dp"
                android:layout_marginBottom="4dp" />

            <Button android:id="@+id/settingsBtnUpdateBlocklists"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Update Blocklists"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:backgroundTint="#333366"
                android:gravity="center|start"
                android:paddingStart="16dp"
                android:layout_marginBottom="4dp" />

            <Button android:id="@+id/settingsBtnClearStats"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Clear Statistics"
                android:textSize="14sp"
                android:textColor="#ff6666"
                android:backgroundTint="#442222"
                android:gravity="center|start"
                android:paddingStart="16dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
